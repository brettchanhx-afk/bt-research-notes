    "## 第三部分：宏观风险配置模型"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 宏观风险配置模型\n",
    "print(\"=\" * 70)\n",
    "print(\"宏观风险配置模型\")\n",
    "print(\"=\" * 70)\n",
    "print(\"\"\"\n",
    "基本思想:\n",
    "如果认为某个维度宏观因子将会上行，自然希望行业组合在这个因子上能够暴露得多一些，\n",
    "以获得因子上行带来的收益；若判断某个宏观因子将会下行也是类似的道理。\n",
    "\n",
    "该逻辑可以用凸二次优化器表达:\n",
    "  argmin λ·Δw'ΣΔw + (1-λ)·Σ[(Δw'B)_f - |E₀_f|·V_f]²\n",
    "  \n",
    "约束条件:\n",
    "  1. (Δw'B)_f · V_f >= 0, for f in P (有明确观点的因子)\n",
    "  2. (Δw'B)_f = 0, for f in N (无法判断的因子)\n",
    "  3. ΣΔw_i = 0\n",
    "  4. -w₀_i <= Δw_i <= 1-w₀_i\n",
    "\"\"\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 示例: 强复苏情景下的行业配置\n",
    "print(\"=\" * 70)\n",
    "print(\"示例: 强复苏情景行业配置\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "allocator = MacroRiskAllocator(lambda_param=0)\n",
    "\n",
    "# 设置强复苏情景下的宏观观点\n",
    "macro_views = {\n",
    "    'growth': 1,              # 增长上行\n",
    "    'life_inflation': -1,     # 生活端通胀下行\n",
    "    'production_inflation': -1,  # 生产端通胀下行\n",
    "    'risk_free_rate': -1,     # 无风险利率下行(宽松)\n",
    "    'credit_spread': 1,       # 信用利差收窄\n",
    "    'term_spread': 1,         # 期限利差走阔\n",
    "    'exchange_rate': 1        # 人民币升值\n",
    "}\n",
    "\n",
    "print(\"强复苏情景下的宏观观点设置:\")\n",
    "view_mapping = {1: '↑上行', -1: '↓下行', 0: '?不确定'}\n",
    "for factor, view in macro_views.items():\n",
    "    factor_name = FACTOR_CONFIG[factor]['name']\n",
    "    print(f\"  {factor_name}: {view_mapping[view]}\")"
   ]
