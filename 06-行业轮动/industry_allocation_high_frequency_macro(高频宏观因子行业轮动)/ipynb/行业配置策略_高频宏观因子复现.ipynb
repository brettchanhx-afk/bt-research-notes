   "source": [
    "## 第四部分：戴维斯双击策略"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 戴维斯双击策略\n",
    "print(\"=\" * 70)\n",
    "print(\"戴维斯双击策略 (Davis Double Hit)\")\n",
    "print(\"=\" * 70)\n",
    "print(\"\"\"\n",
    "核心理念:\n",
    "行业盈利能力变化(Δg)和估值水平变化(ΔPB)如果同时正向变化，\n",
    "将形成戴维斯双击效应，带来超额收益。\n",
    "\n",
    "策略步骤:\n",
    "  1. 以行业ROE_TTM季度差分作为Δg的代理变量\n",
    "  2. 以实时PB对数的季度差分作为ΔPB的代理变量\n",
    "  3. 使用滚动回归建立动态的宏观-Δg映射关系\n",
    "  4. 使用滚动回归建立动态的宏观-ΔPB映射关系\n",
    "  5. 利用高频宏观因子实时预测Δg和ΔPB\n",
    "  6. 选择预测Δg>0 且 ΔPB>0 的行业\n",
    "\"\"\")\n",
    "\n",
    "davis_strategy = DavisDoubleHitStrategy(lookback_window=52)\n",
    "print(\"戴维斯双击策略初始化成功!\")\n",
    "print(f\"滚动回归窗口: {davis_strategy.lookback_window} 周 (约1年)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 第五部分：策略回测 (基于真实获取的行业数据)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 基于真实获取的行业数据进行回测\n",
    "if len(industry_pivot) > 100:\n",
    "    print(\"=\" * 70)\n",
    "    print(\"使用真实行业数据进行策略回测\")\n",
    "    print(\"=\" * 70)\n",
    "    \n",
    "    # 将日频数据转换为周频\n",
    "    industry_weekly = industry_pivot.resample('W-FRI').last()\n",
    "    industry_returns_weekly = industry_weekly.pct_change().dropna()\n",
    "    \n",
    "    print(f\"周频数据维度: {industry_weekly.shape}\")\n",
    "    print(f\"时间范围: {industry_weekly.index.min()} 至 {industry_weekly.index.max()}\")\n",
    "    \n",
    "    # 基准: 等权持有所有行业\n",
    "    benchmark_returns = industry_returns_weekly.mean(axis=1)\n",
    "    benchmark_cumulative = (1 + benchmark_returns).cumprod()\n",
    "    \n",
    "    # 简化策略: 基于历史动量选择行业\n",
    "    # 实际应用应使用davis_strategy进行预测\n",
    "    lookback = 52\n",
    "    top_n = 10\n",
    "    \n",
    "    rebalance_dates = industry_returns_weekly.resample('QE').last().index\n",
    "    \n",
    "    selected_industries_list = []\n",
    "    strategy_returns = []\n",
    "    \n",
    "    for i in range(1, len(rebalance_dates)):\n",
    "        hist_start = rebalance_dates[i-1]\n",
    "        hist_end = rebalance_dates[i]\n",
    "        \n",
    "        if hist_end > industry_returns_weekly.index.max():\n",
    "            break\n",
    "            \n",
    "        hist_returns = industry_returns_weekly.loc[:hist_end].tail(lookback)\n",
    "        if len(hist_returns) < lookback // 2:\n",
    "            continue\n",
    "            \n",
    "        mean_returns = hist_returns.mean().sort_values(ascending=False)\n",
    "        top_10_industries = mean_returns.head(top_n).index.tolist()\n",
    "        \n",
    "        selected_industries_list.append({\n",
    "            'date': hist_end,\n",
    "            'selected': top_10_industries\n",
    "        })\n",
    "        \n",
    "        next_start = hist_end\n",
    "        next_end = rebalance_dates[i+1] if i+1 < len(rebalance_dates) else industry_returns_weekly.index.max()\n",
    "        \n",
    "        next_returns = industry_returns_weekly.loc[next_start:next_end]\n",
    "        if len(next_returns) > 0:\n",
    "            strategy_ret = next_returns[top_10_industries].mean(axis=1).mean()\n",
    "            strategy_returns.append({\n",
    "                'date': next_returns.index[int(len(next_returns)//2)],\n",
    "                'return': strategy_ret\n",
    "            })\n",
    "    \n",
    "    if strategy_returns:\n",
    "        strategy_df = pd.DataFrame(strategy_returns).set_index('date')\n",
    "        print(f\"\\n回测期数: {len(strategy_df)}\")\n",
    "        print(f\"调仓次数: {len(selected_industries_list)}\")\n",
    "else:\n",
    "    print(\"行业数据不足，无法进行回测\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 计算并展示回测结果\n",
    "if strategy_returns and len(strategy_df) > 10:\n",
    "    strategy_cumulative = (1 + strategy_df['return']).cumprod()\n",
    "    benchmark_aligned = benchmark_cumulative.loc[strategy_df.index]\n",
    "    \n",
    "    # 计算指标\n",
    "    total_return = strategy_cumulative.iloc[-1] - 1\n",
    "    annual_return = (1 + total_return) ** (4 / len(strategy_df)) - 1\n",
    "    annual_vol = strategy_df['return'].std() * np.sqrt(4)\n",
    "    sharpe = annual_return / annual_vol if annual_vol > 0 else 0\n",
    "    \n",
    "    # 最大回撤\n",
    "    running_max = strategy_cumulative.cummax()\n",
    "    drawdown = (strategy_cumulative - running_max) / running_max\n",
    "    max_drawdown = drawdown.min()\n",
    "    \n",
    "    # 超额收益\n",
    "    excess_returns = strategy_df['return'] - benchmark_aligned.pct_change().dropna().values\n",
    "    excess_cumulative = (1 + excess_returns.dropna()).cumprod()\n",
    "    excess_return = excess_cumulative.iloc[-1] - 1 if len(excess_cumulative) > 0 else 0\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 50)\n",
    "    print(\"策略表现指标\")\n",
    "    print(\"=\" * 50)\n",
    "    print(f\"总收益率: {total_return:.2%}\")\n",
    "    print(f\"年化收益率: {annual_return:.2%}\")\n",
    "    print(f\"年化波动率: {annual_vol:.2%}\")\n",
    "    print(f\"夏普比率: {sharpe:.2f}\")\n",
    "    print(f\"最大回撤: {max_drawdown:.2%}\")\n",
    "    print(f\"超额收益率: {excess_return:.2%}\")\n",
    "else:\n",
    "    print(\"回测数据不足，无法计算绩效指标\")"
   ]
